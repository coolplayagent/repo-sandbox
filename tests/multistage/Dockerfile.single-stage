# syntax=docker/dockerfile:1.7
# This is the checked-in pre-change central template plus the same task source.
# It keeps exactly the same Rust, Cargo, C compiler, Git, CA and Bazel behavior;
# its extra contents are the natural consequence of single-stage inheritance.
ARG BASE_IMAGE=docker.io/library/rust:1.97.0-bookworm
FROM ${BASE_IMAGE} AS task
ARG TARGETARCH
ARG RUST_VERSION=1.97.0
ARG BAZELISK_VERSION=1.27.0
ARG BAZEL_VERSION=8.3.1
ARG SOURCE_DIGEST
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl git \
    && case "$TARGETARCH" in amd64) bazel_arch=x86_64 ;; arm64) bazel_arch=arm64 ;; *) exit 64 ;; esac \
    && curl --fail --location --show-error \
      "https://github.com/bazelbuild/bazelisk/releases/download/v${BAZELISK_VERSION}/bazelisk-linux-${TARGETARCH}" \
      --output /usr/local/bin/bazelisk \
    && curl --fail --location --show-error \
      "https://github.com/bazelbuild/bazel/releases/download/${BAZEL_VERSION}/bazel-${BAZEL_VERSION}-linux-${bazel_arch}" \
      --output /usr/local/bin/bazel \
    && chmod 0755 /usr/local/bin/bazel /usr/local/bin/bazelisk \
    && rustup default "$RUST_VERSION" \
    && ln -sf "$(rustup which --toolchain "$RUST_VERSION" rustc)" /usr/local/cargo/bin/rustc \
    && ln -sf "$(rustup which --toolchain "$RUST_VERSION" rustdoc)" /usr/local/cargo/bin/rustdoc \
    && rm -rf /var/lib/apt/lists/*
COPY offline-baseline/ /opt/repo-sandbox/offline-baseline/
RUN set -eu; \
    cd /opt/repo-sandbox/offline-baseline; \
    cp BUILD.seed BUILD.bazel; \
    mkdir -p /var/cache/repo-sandbox/bazel /usr/local/share/repo-sandbox/offline-baseline; \
    cp MODULE.bazel.lock /tmp/repo-sandbox-baseline.lock; \
    bazel --batch --output_user_root=/var/cache/repo-sandbox/bazel mod graph >/dev/null; \
    sed -n '/^  "registryFileHashes": {$/,/^  },$/p' \
      /tmp/repo-sandbox-baseline.lock >/tmp/repo-sandbox-expected-hashes; \
    sed -n '/^  "registryFileHashes": {$/,/^  },$/p' \
      MODULE.bazel.lock >/tmp/repo-sandbox-actual-hashes; \
    test -s /tmp/repo-sandbox-expected-hashes; \
    cmp /tmp/repo-sandbox-expected-hashes /tmp/repo-sandbox-actual-hashes; \
    bazel --batch --output_user_root=/var/cache/repo-sandbox/bazel test //...; \
    cp MODULE.bazel.lock /usr/local/share/repo-sandbox/offline-baseline/MODULE.bazel.lock; \
    find /var/cache/repo-sandbox/bazel -mindepth 1 -maxdepth 1 ! -name cache -exec rm -rf '{}' +; \
    find /var/cache/repo-sandbox/bazel/cache -mindepth 1 -maxdepth 1 ! -name repos -exec rm -rf '{}' +; \
    rm -rf /opt/repo-sandbox /tmp/repo-sandbox-baseline.lock \
      /tmp/repo-sandbox-expected-hashes /tmp/repo-sandbox-actual-hashes
COPY bazel /tmp/repo-sandbox-bazel-wrapper
RUN set -eu; \
    mkdir -p /usr/local/libexec/repo-sandbox; \
    mv /usr/local/bin/bazel /usr/local/libexec/repo-sandbox/bazel-8.3.1; \
    install -m 0755 /tmp/repo-sandbox-bazel-wrapper /usr/local/bin/bazel; \
    rm /tmp/repo-sandbox-bazel-wrapper
COPY --link source/ /workspace/
WORKDIR /workspace
RUN cp BUILD.seed BUILD.bazel
LABEL io.repo-sandbox.source.digest="${SOURCE_DIGEST}"

FROM task AS acceptance
RUN cargo test --locked \
    && bazel --batch --ignore_all_rc_files build //:rust_binary
