load("@rules_cc//cc:cc_test.bzl", "cc_test")

genrule(
    name = "rust_binary",
    srcs = ["src/main.rs"],
    outs = ["multistage-smoke"],
    # Bazel sanitizes action PATH; both comparison images install this compiler.
    cmd = "/usr/local/cargo/bin/rustc $(location src/main.rs) -o $@ && test \"$$($@)\" = 42",
)

cc_test(
    name = "tests",
    srcs = ["test.cc"],
)
